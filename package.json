{
  "name": "gaming-zone-monopolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "server:dev": "wrangler dev -c server/wrangler.toml",
    "server:deploy": "wrangler deploy -c server/wrangler.toml",
    "server:typecheck": "tsc --noEmit -p server/tsconfig.json",
    "server:smoke": "node server/scripts/smoke.mjs"
  },
  "dependencies": {
    "@fontsource/bungee": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wrangler": "^4.166.0"
  }
}
